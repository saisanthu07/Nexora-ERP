# Pooled connection string (used by the running app)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require&pgbouncer=true"

# Direct (non-pooled) connection string — used only for running migrations
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Long random string — generate with: openssl rand -base64 48
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="24h"

PORT=4000

# Comma-separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:5173"
