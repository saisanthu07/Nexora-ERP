generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  SALES
  WAREHOUSE
  ACCOUNTS
}

enum CustomerType {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  LEAD
}

enum StockMovementType {
  IN
  OUT
}

enum ChallanStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role
  createdAt    DateTime  @default(now())
  challans     Challan[]

  @@map("users")
}

model Customer {
  id           String         @id @default(uuid())
  name         String
  phone        String
  email        String?
  address      String?
  businessName String?
  gstNumber    String?
  type         CustomerType   @default(RETAIL)
  status       CustomerStatus @default(LEAD)
  followUpDate DateTime?
  notes        Note[]
  challans     Challan[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([name])
  @@index([phone])
  @@map("customers")
}

model Note {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  content    String
  createdBy  String
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@map("notes")
}

model Product {
  id             String          @id @default(uuid())
  name           String
  sku            String          @unique
  category       String
  price          Decimal         @db.Decimal(10, 2)
  stock          Int             @default(0)
  minStock       Int             @default(0)
  warehouse      String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockMovements StockMovement[]
  challanItems   ChallanItem[]

  @@index([sku])
  @@index([category])
  @@map("products")
}

model StockMovement {
  id        String            @id @default(uuid())
  productId String
  product   Product           @relation(fields: [productId], references: [id])
  type      StockMovementType
  quantity  Int
  reason    String
  refType   String?
  refId     String?
  createdBy String
  createdAt DateTime          @default(now())

  @@index([productId])
  @@map("stock_movements")
}

model ChallanSequence {
  id         Int @id @default(1)
  year       Int
  lastNumber Int @default(0)

  @@map("challan_sequence")
}

model Challan {
  id            String        @id @default(uuid())
  challanNumber String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  status        ChallanStatus @default(DRAFT)
  items         ChallanItem[]
  totalQuantity Int           @default(0)
  totalAmount   Decimal       @default(0) @db.Decimal(12, 2)
  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id])
  confirmedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([customerId])
  @@index([status])
  @@map("challans")
}

model ChallanItem {
  id        String  @id @default(uuid())
  challanId String
  challan   Challan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  productNameSnapshot String
  skuSnapshot         String
  priceSnapshot        Decimal @db.Decimal(10, 2)

  quantity  Int
  lineTotal Decimal @db.Decimal(12, 2)

  @@index([challanId])
  @@map("challan_items")
}
